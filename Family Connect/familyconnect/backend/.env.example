# No usable credentials belong in tracked templates.
# Copy to .env. Configure an existing or new local PostgreSQL database.
DATABASE_URL=
JWT_SECRET=
PORT=3104
LISTEN_HOST=127.0.0.1
REDIS_URL=
REDIS_DISABLED=1
GEMINI_API_KEY=

# Optional Ultimate shared-session integration; server-only values.
ULTIMATE_BRIDGE_SECRET=
# Explicitly link an existing Family account; configure both IDs together.
ULTIMATE_OWNER_ID=
ULTIMATE_FAMILY_USER_ID=
