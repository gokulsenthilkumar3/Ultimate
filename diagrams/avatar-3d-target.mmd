flowchart LR
  subgraph DATA["1 / Assets and data"]
    ASSETS["Pinned public assets<br/>Basis / textures / manifests"]
    API["Canonical API save adapter<br/>Existing auth and revision checks"]
    DB[("SQLite<br/>Semantic avatar document")]
    CACHE["NEW / Owner-scoped local cache<br/>Document drafts + baked viewer GLB<br/>Hash and revision keyed"]
    API --> DB
  end
  subgraph STATE["2 / Browser state and orchestration"]
    UI["Editor UI<br/>Semantic controls only"]
    DOC["Avatar session<br/>Owner / person / Current or Goal<br/>No geometry in persistent state"]
    CTRL["NEW / EditorController<br/>Debounce / cancel / latest revision<br/>Commit coherent render packet"]
    UI --> DOC
    DOC --> CTRL
  end
  subgraph COMPUTE["3 / Web Workers"]
    BAKE["NEW / IdentityBakeWorker<br/>CPU identity + posed-body evaluation<br/>Typed-array packets"]
    FIT["GarmentFitWorker<br/>Reuse BVH / proxies<br/>Convergence and pose scope"]
  end
  subgraph DISPLAY["4 / Rendering and delivery"]
    PREVIEW["Thin editor preview adapter<br/>Accept validated packets only"]
    VIEWER["NEW / Read-only AvatarViewer<br/>Load baked GLB<br/>No identity or garment jobs"]
    SCENE["SceneManager / R3F<br/>Camera / neutral lighting / PBR<br/>Demand rendering"]
    EXPORT["Browser export service<br/>Accepted revision only<br/>GLB / editable ZIP downloads"]
    PREVIEW --> SCENE
    VIEWER --> SCENE
  end
  ASSETS -->|editor assets| CTRL
  DOC -->|semantic JSON only| API
