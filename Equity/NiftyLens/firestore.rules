rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function owner(uid) { return request.auth != null && request.auth.uid == uid; }
  function validSymbol(value) { return value is string && value.size() > 0 && value.size() <= 128; }
  match /price_cache/{symbol} { allow read: if true; allow write: if false; }
  match /watchlists/{uid} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['symbols', 'updatedAt'])
    && request.resource.data.symbols is list && request.resource.data.symbols.size() <= 500
    && request.resource.data.updatedAt is timestamp;
  }
  match /portfolios/{uid}/holdings/{id} {
   allow read, delete: if owner(uid);
   allow create, update: if owner(uid)
    && request.resource.data.keys().hasOnly(['symbol', 'qty', 'avg_price', 'buy_date', 'createdAt'])
    && validSymbol(request.resource.data.symbol)
    && request.resource.data.qty is number && request.resource.data.qty > 0 && request.resource.data.qty <= 1000000000000
    && request.resource.data.avg_price is number && request.resource.data.avg_price >= 0 && request.resource.data.avg_price <= 1000000000000
    && request.resource.data.buy_date is string && request.resource.data.createdAt is timestamp;
  }
  match /alerts/{uid}/items/{id} {
   allow read, delete: if owner(uid);
   allow create: if owner(uid)
    && request.resource.data.keys().hasOnly(['symbol', 'condition', 'threshold', 'channel', 'triggered_at', 'createdAt'])
    && validSymbol(request.resource.data.symbol)
    && request.resource.data.condition in ['above', 'below']
    && request.resource.data.threshold is number && request.resource.data.threshold > 0 && request.resource.data.threshold <= 1000000000000
    && request.resource.data.channel in ['email', 'telegram']
    && request.resource.data.triggered_at == null && request.resource.data.createdAt is timestamp;
  }
 }
}
