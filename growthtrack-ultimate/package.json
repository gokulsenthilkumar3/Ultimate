{
  "name": "ultimate",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "Ultimate - GrowthTrack Digital Twin Engine — Fitness, Finance, 3D Body & Personal Dashboard",
  "main": "desktop.js",
  "build": {
    "appId": "com.growthtrack.ultimate",
    "asar": true,
    "productName": "GrowthTrack Ultimate",
    "directories": {
      "output": "../growthtrack-release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "prisma/**/*",
      "prisma-generated/**/*",
      "scripts/**/*",
      "desktop.js",
      "desktop-config.js",
      "desktop-setup.html",
      "preload.cjs",
      "server.js",
      "logger.js",
      "src/lib/bodyMetricContract.js",
      "src/lib/agentActions.js",
      "src/lib/agentPolicy.js",
      "src/lib/aiContextTypes.js",
      "src/config/products.js",
      "src/components/calendar/calendarICS.js",
      "src/components/calendar/calendarModel.js",
      "src/domains/workspace/contracts/**/*",
      "!**/*.db",
      "!**/*.db-*",
      "!**/.env*",
      "!**/uploads/**",
      "!**/vault/**",
      "!**/.code-index/**",
      "!**/.codeindexignore",
      "package.json",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/prisma/**/*"
    ],
    "extraResources": [
      "prisma/schema.prisma"
    ]
  },
  "scripts": {
    "dev:design": "vite --config vite.admin-demo.config.js",
    "build:design": "vite build --config vite.admin-demo.config.js",
    "test:design": "vitest run --config vite.admin-demo.config.js",
    "build:desktop": "node scripts/build-desktop.mjs",
    "dev": "concurrently \"vite\" \"node server.js\"",
    "build": "vite build",
    "humanoid:realism": "node scripts/build-human-realism.mjs",
    "humanoid:parametric": "node scripts/import-parametric-human.mjs",
    "test:e2e:parametric": "playwright test --config playwright.parametric.config.ts",
    "humanoid:source": "node scripts/build-human-realism.mjs --source",
    "validate:human-family": "node scripts/validate-human-family.mjs",
    "validate:private-anatomy": "node scripts/verify-private-anatomy.mjs",
    "validate:private-motion": "node scripts/verify-native-motion.mjs",
    "humanoid:live": "node scripts/build-live-human.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:agents": "vitest run tests/unit/agents. --maxWorkers=2",
    "test:agents:e2e": "playwright test --config playwright.agents.config.ts",
    "test:human-spec": "node scripts/test-human-spec.mjs",
    "test:run": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test tests/e2e/physique-visual.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "analyze": "vite build --mode analyze",
    "performance:pages": "node scripts/page-performance.mjs",
    "performance:kinetic": "node scripts/page-performance.mjs --browser=chrome --pages=welcome,login,overview --motion=no-preference --interact --settle-ms=1800",
    "performance:kinetic:soak": "node scripts/page-performance.mjs --browser=chrome --pages=overview --motion=no-preference --soak-minutes=30 --label=kinetic-soak",
    "check:kinetic-budgets": "node scripts/kinetic-budgets.mjs --check",
    "test:kinetic": "vitest run src/components/motion/KineticMotion.test.tsx src/design/kinetic.test.ts src/components/ui/DataTable.virtual.test.tsx src/components/ui/VisibleResponsiveContainer.test.tsx src/App.entry.test.jsx src/App.signout.test.jsx",
    "performance:check": "node scripts/check-page-performance.mjs",
    "validate:glb": "node scripts/validate-glb.js && node scripts/validate-glb.js public/assets/models/humanoid-adult-v2-lite.glb && node scripts/validate-glb.js public/assets/models/humanoid-base.glb && node scripts/validate-glb.js public/assets/models/humanoid-base-lite.glb && node scripts/validate-glb.js public/assets/models/humanoid-preview-75.glb && node scripts/validate-glb.js public/assets/models/humanoid-preview-75-lite.glb && node scripts/validate-glb-format.mjs && node scripts/validate-human-family.mjs",
    "validate:glb-format": "node scripts/validate-glb-format.mjs",
    "normalize:glb-format": "node scripts/normalize-human-glb-format.mjs --write",
    "humanoid:upgrade": "node scripts/upgrade-human-attachments.mjs",
    "wardrobe:build": "node scripts/build-wardrobe-assets.mjs",
    "bake:surface": "node scripts/bake-geometry-surface.mjs --repack-albedo",
    "plan:model": "node scripts/plan-preview/build-model.mjs",
    "plan:viewer": "node scripts/plan-preview/build-viewer.mjs",
    "calibrate:features": "node scripts/calibrate-humanoid-features.mjs",
    "glb:health": "node scripts/glb-health.js",
    "glb:priority-fixes": "node scripts/glb-priority-fixes.js",
    "quality:gate": "node scripts/quality-gate.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "owner:create": "node scripts/create-owner.js",
    "db:sync": "prisma generate && prisma db push",
    "db:seed-config": "node scripts/seed-app-config.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "migrate:notes": "node scripts/migrate-notes.mjs",
    "migrate:records": "node scripts/migrate-records.mjs",
    "check:assets": "node scripts/check-asset-provenance.mjs",
    "humanoid:fetch": "python -I scripts/makehuman/fetch_sources.py",
    "humanoid:compile": "python -I scripts/makehuman/compile_sources.py --makehuman .tmp/makehuman-v1.3.0/makehuman/data --assets .tmp/makehuman-cc0-assets --targets scripts/makehuman/export-targets.json --out .tmp/makehuman-cc0-compiled",
    "deploy:secrets": "node scripts/setup-deployment-secrets.mjs",
    "test:container": "node scripts/test-container.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-three/drei": "10.7.7",
    "@react-three/fiber": "9.6.1",
    "@react-three/postprocessing": "3.0.4",
    "@sentry/react": "^10.70.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@stripe/stripe-js": "^9.13.0",
    "@tanstack/react-query": "^5.100.11",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "detect-gpu": "^5.0.70",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "framer-motion": "^14.8.0",
    "gsap": "3.15.0",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "1.8.0",
    "mixpanel-browser": "^2.82.0",
    "multer": "^2.5.0",
    "postprocessing": "6.39.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-easy-crop": "^6.2.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.18.4",
    "react-window": "^2.2.7",
    "recharts": "3.8.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "resend": "^6.20.0",
    "stripe": "^22.5.0",
    "three": "0.184.0",
    "unified": "^11.0.5",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.6.7",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.59.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "globals": "17.4.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "jsdom": "^29.0.2",
    "meshoptimizer": "1.1.1",
    "prisma": "^7.9.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "three-mesh-bvh": "0.8.3",
    "typescript": "^6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
