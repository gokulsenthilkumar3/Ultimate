/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Cross-Origin-Resource-Policy: same-site
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://localhost:3001 http://127.0.0.1:3001 http://localhost:11434 http://127.0.0.1:11434 ws://localhost:* ws://127.0.0.1:* https://api.open-meteo.com https://nominatim.openstreetmap.org https://hacker-news.firebaseio.com https://news.ycombinator.com https://api.github.com https://api.trakt.tv

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/404.html
  Cache-Control: no-cache, no-store, must-revalidate
