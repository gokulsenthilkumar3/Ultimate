# Local database and owner bootstrap
DATABASE_URL=file:./dev.db
DATABASE_PROVIDER=sqlite
# SQL Server alternative (server only): DATABASE_PROVIDER=sqlserver
# DATABASE_URL=sqlserver://localhost:14333;database=GrowthTrackDB;user=;password=;encrypt=true;
# Configure SQL Server backup jobs; SQLite BACKUP_ENABLED cannot protect SQL Server.
# Enable only after the Notes migration and parity/restore rehearsal pass.
GROWTHTRACK_NOTES_V1=0
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=
VITE_AUTH_PROVIDER=local
VITE_CLERK_ENABLED=false

# Shared Family identity (server only). Use the same random 64-hex secret in Family's ULTIMATE_BRIDGE_SECRET.
FAMILY_API_URL=http://127.0.0.1:3104
FAMILY_ULTIMATE_SECRET=

# Server security
PORT=3001
APP_URL=http://localhost:5000/Ultimate
APP_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SESSION_HOURS=12
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
TRUST_PROXY=false
LISTEN_HOST=127.0.0.1
# Exact additional browser connection origins (comma-separated, no paths/wildcards).
# Same-origin API and WebSocket traffic is already allowed.
CSP_CONNECT_ORIGINS=https://api.open-meteo.com
# Optional owner authenticator. Run npm run mfa:setup locally; keep the secret private.
OWNER_MFA_SECRET=
APP_ENCRYPTION_KEY=

# Read-only customer administration; configure each product independently.
# URLs are HTTPS product bases, with optional deployment base path.
# READERS contains Ultimate database user IDs, never customer handoff tokens.
CUSTOMER_ADMIN_FINSYNC_URL=
CUSTOMER_ADMIN_FINSYNC_TOKEN=
CUSTOMER_ADMIN_FINSYNC_READERS=
CUSTOMER_ADMIN_OXFIN_URL=
CUSTOMER_ADMIN_OXFIN_TOKEN=
CUSTOMER_ADMIN_OXFIN_READERS=
# 64 hex characters; enables encryption for NEW vault uploads. Keep the key.
# Existing plaintext files and SQLite records require separate migration/storage protection.
# The same key seals live-data connection secrets (stock API key, private calendar URL).
# Background refresh of connected sources; set to off to sync only on request.
GROWTHTRACK_SYNC_SCHEDULER=on
# Store calendar events and holdings as revisioned rows. Run `npm run migrate:records`
# (rehearsal), then `npm run migrate:records -- --apply`, before setting this to 1.
GROWTHTRACK_RECORD_ROWS=0
HANDOFF_SECRET=
# Optional encrypted database backups; requires APP_ENCRYPTION_KEY.
# BACKUP_DIR may be a protected mounted/off-device destination. No automatic deletion.
BACKUP_ENABLED=off
BACKUP_DIR=backups
BACKUP_INTERVAL_HOURS=24
BACKUP_FIRST_RUN_SECONDS=60

# Optional Supabase client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional monitoring
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional billing
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App
VITE_APP_NAME=Ultimate
VITE_APP_URL=http://localhost:5000/Ultimate
API_PROXY_TARGET=http://127.0.0.1:3000

# Workspace gateway and standalone products
# gateway.mjs listens on GATEWAY_PORT and proxies /api/<product>/* to each
# product's API. workspace.mjs starts each product on these ports.
GATEWAY_PORT=3000
GATEWAY_URL=http://127.0.0.1:3000
ULTIMATE_API_URL=http://127.0.0.1:3001
AGENT_API_URL=http://127.0.0.1:11434

# Agents AI provider (backend only; never prefix the key with VITE_).
# Copy these into growthtrack-ultimate/.env and enter your key locally.
# Adding GROQ_API_KEY selects Groq automatically unless AGENTS_PROVIDER is set.
# Set AGENTS_PROVIDER=ollama to keep local inference with OLLAMA_BASE_URL.
AGENTS_PROVIDER=groq
GROQ_API_KEY=
# Optional typed decision advice. Disabled unless explicitly enabled on the server.
JEV_ENABLED=false
# Optional local Laya server; choose explicitly, never automatic failover.
AGENTS_DECISION_PROVIDER=jev
LAYA_ENABLED=false
LAYA_BASE_URL=http://127.0.0.1:8011
LAYA_API_KEY=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# json is the compatibility default. Opt in to toon/auto after model evaluation.
AGENTS_CONTEXT_FORMAT=json
GROQ_DEFAULT_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Product API upstreams — must match the ports in workspace.mjs / scripts below
# Generate HANDOFF_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FINSYNC_API_URL=http://127.0.0.1:5101
OXFIN_API_URL=http://127.0.0.1:5102
FAMILY_API_URL=http://127.0.0.1:5104
EQUITY_API_URL=http://127.0.0.1:5105
FOREX_API_URL=http://127.0.0.1:8501

# Optional overrides; every setting, its default and its range are listed in
# docs/CONFIGURATION.md. Invalid values stop the server with a clear message.
# APP_ORIGINS=https://app.example.com
# API_RATE_LIMIT_PER_MINUTE=120
# LOG_RETENTION_DAYS=90
# LOG_CLEANUP_ENABLED=on
# COMPANION_FINSYNC_URL=http://localhost:5101
# SYNC_INTERVAL_ICS_MINUTES=60
# SYNC_MFAPI_BASE_URL=https://api.mfapi.in
