# Local database and owner bootstrap
DATABASE_URL=file:./dev.db
OWNER_EMAIL=
OWNER_NAME=
OWNER_PASSWORD=

# Server security
PORT=3001
APP_URL=http://localhost:5000/Ultimate
APP_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SESSION_HOURS=12
LOGIN_WINDOW_MS=900000
LOGIN_MAX_ATTEMPTS=5
TRUST_PROXY=false
APP_ENCRYPTION_KEY=

# Optional Supabase client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional monitoring
VITE_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Optional billing
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# App
VITE_APP_NAME=Ultimate
VITE_APP_URL=http://localhost:5000/Ultimate
API_PROXY_TARGET=http://127.0.0.1:3001
