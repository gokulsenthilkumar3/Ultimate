datasource db {
  provider = "sqlserver"
}

generator client {
  provider = "prisma-client-js"
  output = "../prisma-generated/sqlserver"
}

model User {
  id                 String   @id @default(uuid()) @db.NVarChar(200)
  email              String   @unique @db.NVarChar(200)
  passwordHash       String @db.NVarChar(Max)
  fullName           String @db.NVarChar(Max)
  subscriptionTier   String?  @default("free") @db.NVarChar(Max)
  stripeCustomerId   String? @db.NVarChar(200)
  subscriptionStatus String? @db.NVarChar(Max)
  referralCode       String   @unique @default(uuid()) @db.NVarChar(200)
  creditBalance      Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt

  // Typed plans and collections below own their regular records. Their old
  // strings remain only for malformed migration inputs and rollback workflows.
  // Lifestyle/wellness configuration still uses bounded JSON documents.
  trainingPlan      String? @db.NVarChar(Max)
  nutritionStrategy String? @db.NVarChar(Max)
  lifestyleTips     String? @db.NVarChar(Max)
  medicalData       String? @db.NVarChar(Max)
  physiqueTargets   String? @db.NVarChar(Max)
  assessmentQA      String? @db.NVarChar(Max)
  skills            String? @db.NVarChar(Max)
  calendarEvents    String? @db.NVarChar(Max)
  wellnessData      String? @db.NVarChar(Max)
  healthExtras      String? @db.NVarChar(Max)
  // Legacy collection documents are retained only for malformed migration
  // inputs or the explicit calendar/portfolio rollback workflow.
  manualProjects    String? @db.NVarChar(Max)
  repoNotes         String? @db.NVarChar(Max)
  portfolio         String? @db.NVarChar(Max)

  // Relations
  tasks                  Task[]
  transactions           Transaction[]
  budgets                Budget[]
  metricLogs             MetricLog[]
  nutritionLogs          NutritionLog[]
  workoutSessions        WorkoutSession[]
  shoppingItems          ShoppingItem[]
  timesheetSessions      TimesheetSession[]
  entertainmentMedia     EntertainmentMedia[]
  notes                  Note[]
  noteMutations          NoteMutation[]
  noteChanges            NoteChange[]
  goals                  Goal[]
  sleepLogs              SleepLog[]
  documents              Document[]
  habits                 Habit[]
  subscriptions          SubscriptionItem[]
  moodLogs               MoodLog[]
  vitalsLogs             VitalsLog[]
  medications            Medication[]
  authSessions           AuthSession[]
  preference             UserPreference?
  ownerProfile           OwnerProfile?
  socialProfiles         SocialProfile[]
  bodyProfile            BodyProfile?
  healthProfile          HealthProfile?
  locationPoints         LocationPoint[]
  customTables           CustomTable[]
  integrationCredentials IntegrationCredential[]
  calendarEventRows      CalendarEvent[]
  portfolioHoldings      PortfolioHolding[]
  recordMutations        RecordMutation[]
  recordChanges          RecordChange[]
  progressPhotos         ProgressPhoto[]
  goalProgressLogs       GoalProgressLog[]
  createdBy              String? @db.NVarChar(Max)
  updatedBy              String? @db.NVarChar(Max)
  skillRows              UserSkill[]
  manualProjectRows      ManualProject[]
  repositoryNoteRows     RepositoryNote[]
  assessmentRounds       AssessmentRound[]
  trainingPlanRecord     TrainingPlan?
  nutritionStrategyRecord NutritionStrategy?
  medicalPlanRecord      MedicalPlan?
  physiquePlanRecord     PhysiquePlan?

}

model UserSkill {
  id String @id @default(uuid()) @db.NVarChar(200)
  userId String @db.NVarChar(200)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position Int
  clientId String? @db.NVarChar(200)
  clientIdType String? @db.NVarChar(Max)
  clientCreatedAt String? @db.NVarChar(Max)
  clientUpdatedAt String? @db.NVarChar(Max)
  name String? @db.NVarChar(Max)
  category String? @db.NVarChar(200)
  xp Float?
  description String? @db.NVarChar(Max)
  weeklyTarget Float?
  resource String? @db.NVarChar(Max)
  nextAction String? @db.NVarChar(Max)
  lastPracticed String? @db.NVarChar(Max)
  practiceCount Int?
  data String? @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  @@unique([userId, position])
  @@index([userId, category])
  @@map("user_skills")

}

model ManualProject {
  id String @id @default(uuid()) @db.NVarChar(200)
  userId String @db.NVarChar(200)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position Int
  clientId String? @db.NVarChar(200)
  clientIdType String? @db.NVarChar(Max)
  clientCreatedAt String? @db.NVarChar(Max)
  clientUpdatedAt String? @db.NVarChar(Max)
  title String? @db.NVarChar(Max)
  description String? @db.NVarChar(Max)
  stack String? @db.NVarChar(Max)
  status String? @db.NVarChar(200)
  url String? @db.NVarChar(Max)
  startDate String? @db.NVarChar(Max)
  endDate String? @db.NVarChar(Max)
  data String? @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  @@unique([userId, position])
  @@index([userId, status])
  @@map("manual_projects")

}

model RepositoryNote {
  id String @id @default(uuid()) @db.NVarChar(200)
  userId String @db.NVarChar(200)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  repositoryId String @db.NVarChar(200)
  note String @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  @@unique([userId, repositoryId])
  @@map("repository_notes")

}

model AssessmentRound {
  id String @id @default(uuid()) @db.NVarChar(200)
  userId String @db.NVarChar(200)
  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position Int
  clientId String? @db.NVarChar(200)
  clientIdType String? @db.NVarChar(Max)
  clientCreatedAt String? @db.NVarChar(Max)
  clientUpdatedAt String? @db.NVarChar(Max)
  round String? @db.NVarChar(Max)
  color String? @db.NVarChar(Max)
  data String? @db.NVarChar(Max)
  answers AssessmentAnswer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  @@unique([userId, position])
  @@map("assessment_rounds")

}

model AssessmentAnswer {
  id String @id @default(uuid()) @db.NVarChar(200)
  roundId String @db.NVarChar(200)
  round AssessmentRound @relation(fields: [roundId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  position Int
  clientId String? @db.NVarChar(200)
  clientIdType String? @db.NVarChar(Max)
  clientCreatedAt String? @db.NVarChar(Max)
  clientUpdatedAt String? @db.NVarChar(Max)
  questionKey String? @db.NVarChar(Max)
  question String? @db.NVarChar(Max)
  answer String? @db.NVarChar(Max)
  data String? @db.NVarChar(Max)
  @@unique([roundId, position])
  @@map("assessment_answers")

}

model AuthSession {
  id         String    @id @default(uuid()) @db.NVarChar(200)
  userId     String @db.NVarChar(200)
  user       User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  tokenHash  String    @unique @db.NVarChar(200)
  csrfHash   String @db.NVarChar(Max)
  ipAddress  String? @db.NVarChar(Max)
  userAgent  String? @db.NVarChar(Max)
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  createdBy  String? @db.NVarChar(Max)
  updatedBy  String? @db.NVarChar(Max)
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([userId, expiresAt])
  @@map("auth_sessions")

}

model UserPreference {
  id                 String   @id @default(uuid()) @db.NVarChar(200)
  userId             String   @unique @db.NVarChar(200)
  user               User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  theme              String   @default("dark") @db.NVarChar(Max)
  palette            String   @default("gold") @db.NVarChar(Max)
  sidebarCollapsed   Boolean  @default(false)
  onboardingComplete Boolean  @default(false)
  navigationOrder    String? @db.NVarChar(Max)
  navigationTabOrder String? @db.NVarChar(Max)
  reducedMotion      Boolean  @default(false)
  density            String   @default("comfortable") @db.NVarChar(Max)
  updatedAt          DateTime @default(now()) @updatedAt
  createdBy          String? @db.NVarChar(Max)
  updatedBy          String? @db.NVarChar(Max)
  createdAt          DateTime @default(now())

  @@map("user_preferences")

}

model OwnerProfile {
  id                        String   @id @default(uuid()) @db.NVarChar(200)
  userId                    String   @unique @db.NVarChar(200)
  user                      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  avatar                    String? @db.NVarChar(Max)
  phone                     String? @db.NVarChar(Max)
  bio                       String? @db.NVarChar(Max)
  dateOfBirth               String? @db.NVarChar(Max)
  gender                    String? @db.NVarChar(Max)
  bloodType                 String? @db.NVarChar(Max)
  locationName              String? @db.NVarChar(Max)
  country                   String? @db.NVarChar(Max)
  state                     String? @db.NVarChar(Max)
  city                      String? @db.NVarChar(Max)
  nationality               String? @db.NVarChar(Max)
  language                  String? @db.NVarChar(Max)
  timezone                  String? @db.NVarChar(Max)
  occupation                String? @db.NVarChar(Max)
  education                 String? @db.NVarChar(Max)
  maritalStatus             String? @db.NVarChar(Max)
  incomeBracket             Float?
  livingSituation           String? @db.NVarChar(Max)
  dietaryPreference         String? @db.NVarChar(Max)
  emergencyContactName      String? @db.NVarChar(Max)
  emergencyContactPhone     String? @db.NVarChar(Max)
  medicalConditions         String? @db.NVarChar(Max)
  allergies                 String? @db.NVarChar(Max)
  restingHeartRate          Float?
  activityLevel             String? @db.NVarChar(Max)
  maintenanceCalories       Float?
  trainingStyle             String? @db.NVarChar(Max)
  baseCurrency              String? @db.NVarChar(Max)
  isdCode                   String? @db.NVarChar(Max)
  netWorth                  Float?
  primaryBank               String? @db.NVarChar(Max)
  passportNationality       String? @db.NVarChar(Max)
  dateFormat                String? @db.NVarChar(Max)
  numberFormat              String? @db.NVarChar(Max)
  measurementSystem         String? @db.NVarChar(Max)
  textDirection             String? @db.NVarChar(Max)
  motherLanguage            String? @db.NVarChar(Max)
  motherLanguageProficiency String? @db.NVarChar(Max)
  privacyLevel              String   @default("Private") @db.NVarChar(Max)
  emailNotifications        Boolean  @default(false)
  smsNotifications          Boolean  @default(false)
  notifications             Boolean  @default(true)
  primaryGoal               String? @db.NVarChar(Max)
  updatedAt                 DateTime @default(now()) @updatedAt
  createdAt                 DateTime @default(now())
  createdBy                 String? @db.NVarChar(Max)
  updatedBy                 String? @db.NVarChar(Max)

  @@map("owner_profiles")

}

model SocialProfile {
  id         String   @id @default(uuid()) @db.NVarChar(200)
  userId     String @db.NVarChar(200)
  user       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider   String @db.NVarChar(200)
  profileUrl String? @db.NVarChar(Max)
  followers  Int      @default(0)
  avgLikes   Int      @default(0)
  avgViews   Int      @default(0)
  enabled    Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  createdBy  String? @db.NVarChar(Max)
  updatedBy  String? @db.NVarChar(Max)

  @@unique([userId, provider])
  @@map("social_profiles")

}

model BodyProfile {
  id     String @id @default(uuid()) @db.NVarChar(200)
  userId String @unique @db.NVarChar(200)
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Canonical measurements. Values are stored in cm, kg, %, and degrees;
  // the UI converts them to the user's preferred display system.
  heightCm           Float?
  weightKg           Float?
  bodyFatPct         Float?
  leanMassKg         Float?
  skeletalMuscleKg   Float?
  bodyWaterPct       Float?
  boneMassKg         Float?
  visceralFatLevel   Float?
  chestCm            Float?
  waistCm            Float?
  shouldersCm        Float?
  armsCm             Float?
  forearmsCm         Float?
  hipsCm             Float?
  thighsCm           Float?
  calvesCm           Float?
  neckCm             Float?
  glutesCm           Float?
  ankleCm            Float?
  wristCm            Float?
  elbowCm            Float?
  underbustCm        Float?
  highHipCm          Float?
  chestDepthCm       Float?
  shoulderBreadthCm  Float?
  bideltoidBreadthCm Float?
  pelvicBreadthCm    Float?
  torsoLengthCm      Float?
  sittingHeightCm    Float?
  upperArmCm         Float?
  lowerArmCm         Float?
  handLengthCm       Float?
  legLengthCm        Float?
  upperLegLengthCm   Float?
  lowerLegLengthCm   Float?
  inseamCm           Float?
  neckLengthCm       Float?
  footLengthCm       Float?
  headCircCm         Float?

  // Left/right values preserve asymmetry without replacing the bilateral
  // summary measurements above.
  leftShoulderCm               Float?
  rightShoulderCm              Float?
  leftUpperArmCircumferenceCm  Float?
  rightUpperArmCircumferenceCm Float?
  leftForearmCm                Float?
  rightForearmCm               Float?
  leftWristCm                  Float?
  rightWristCm                 Float?
  leftThighCm                  Float?
  rightThighCm                 Float?
  leftCalfCm                   Float?
  rightCalfCm                  Float?
  leftHipCm                    Float?
  rightHipCm                   Float?

  // Posture and alignment.
  headTiltAngle        Float?
  pelvicTilt           Float?
  shoulderRounding     Float?
  shoulderTiltDeg      Float?
  spineCurvatureDeg    Float?
  hipRotationDeg       Float?
  kneeAlignmentDeg     Float?
  leftKneeAngleDeg     Float?
  rightKneeAngleDeg    Float?
  leftFootRotationDeg  Float?
  rightFootRotationDeg Float?

  // Face measurements plus authored facial shape channels (0–1 where noted).
  faceWidthCm            Float?
  faceHeightCm           Float?
  eyeSpacingCm           Float?
  earLengthCm            Float?
  earWidthCm             Float?
  noseLengthCm           Float?
  noseWidthCm            Float?
  browDepth              Float?
  noseBridgeWidth        Float?
  noseTipSize            Float?
  earProminence          Float?
  jawWidth               Float?
  chinProjection         Float?
  lipFullness            Float?
  eyeSize                Float?
  targetWeightKg         Float?
  targetBodyFatPct       Float?
  targetLeanMassKg       Float?
  targetSkeletalMuscleKg Float?
  targetChestCm          Float?
  targetWaistCm          Float?
  targetShouldersCm      Float?
  targetArmsCm           Float?
  targetThighsCm         Float?
  targetHipsCm           Float?
  targetGlutesCm         Float?
  targetCalvesCm         Float?

  // Appearance and avatar configuration. Color values are validated by the
  // API; Fitzpatrick remains the stable material fallback for rendering.
  biologicalSex        String? @db.NVarChar(Max)
  modelPreset          String? @db.NVarChar(Max)
  skinTone             String? @db.NVarChar(Max)
  skinFitzpatrickIndex Int?
  skinUndertone        String? @db.NVarChar(Max)
  skinColorHex         String? @db.NVarChar(Max)
  skinTextureVariant   String? @db.NVarChar(Max)
  skinFreckleDensity   Float?
  skinFeatureMap       String? @db.NVarChar(Max)
  hairStyle            String? @db.NVarChar(Max)
  hairColorHex         String? @db.NVarChar(Max)
  hairTexture          String? @db.NVarChar(Max)
  hairlineStyle        String? @db.NVarChar(Max)
  hairPart             String? @db.NVarChar(Max)
  hairDensity          Float?
  hairLengthCm         Float?
  facialHairStyle      String? @db.NVarChar(Max)
  facialHairColorHex   String? @db.NVarChar(Max)
  facialHairDensity    Float?
  eyebrowStyle         String? @db.NVarChar(Max)
  eyebrowColorHex      String? @db.NVarChar(Max)
  eyeColorHex          String? @db.NVarChar(Max)
  eyePattern           String? @db.NVarChar(Max)
  eyelidShape          String? @db.NVarChar(Max)
  eyelashStyle         String? @db.NVarChar(Max)
  scleraColorHex       String? @db.NVarChar(Max)
  irisLimbalRing       Boolean?
  lipColorHex          String? @db.NVarChar(Max)
  bodyHairPattern      String? @db.NVarChar(Max)
  bodyHairColorHex     String? @db.NVarChar(Max)
  bodyHairTexture      String? @db.NVarChar(Max)
  bodyHairDensity      Float?
  nailColorHex         String? @db.NVarChar(Max)
  nailShape            String? @db.NVarChar(Max)
  nailLengthMm         Float?
  avatarAsset          String? @db.NVarChar(Max)
  tattooAsset          String? @db.NVarChar(Max)
  anatomyPreset        String? @db.NVarChar(Max)
  anatomyVisibility    String? @db.NVarChar(Max)
  anatomyRevealConsent Boolean  @default(false)
  morphOverrides       String   @default("{}") @db.NVarChar(Max)
  facialMorphs         String? @db.NVarChar(Max)
  bodyProportions      String? @db.NVarChar(Max)
  skinTones            String? @db.NVarChar(Max)
  skinDetails          String? @db.NVarChar(Max)
  hairProperties       String? @db.NVarChar(Max)
  eyeProperties        String? @db.NVarChar(Max)

  // Localized Skin Shades
  skinShadeHeadHex     String? @db.NVarChar(Max)
  skinShadeNeckHex     String? @db.NVarChar(Max)
  skinShadeTorsoHex    String? @db.NVarChar(Max)
  skinShadeAbsHex      String? @db.NVarChar(Max)
  skinShadeArmsHex     String? @db.NVarChar(Max)
  skinShadeLegsHex     String? @db.NVarChar(Max)
  skinShadeGenitalsHex String? @db.NVarChar(Max)
  skinShadeHandsHex    String? @db.NVarChar(Max)
  skinShadeFeetHex     String? @db.NVarChar(Max)

  updatedAt DateTime @default(now()) @updatedAt
  createdAt DateTime @default(now())
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)

  @@map("body_profiles")

}

model IntegrationCredential {
  id                     String    @id @default(uuid()) @db.NVarChar(200)
  userId                 String @db.NVarChar(200)
  user                   User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  provider               String @db.NVarChar(200)
  accountName            String? @db.NVarChar(Max)
  clientIdCiphertext     String? @db.NVarChar(Max)
  accessTokenCiphertext  String? @db.NVarChar(Max)
  refreshTokenCiphertext String? @db.NVarChar(Max)
  tokenExpiresAt         DateTime?
  enabled                Boolean   @default(true)
  lastSyncAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @default(now()) @updatedAt
  createdBy              String? @db.NVarChar(Max)
  updatedBy              String? @db.NVarChar(Max)

  @@unique([userId, provider])
  @@map("integration_credentials")

}

model AppSetting {
  id        String   @id @default(uuid()) @db.NVarChar(200)
  key       String   @unique @db.NVarChar(200)
  value     String @db.NVarChar(Max)
  valueType String   @default("string") @db.NVarChar(Max)
  category  String   @default("application") @db.NVarChar(Max)
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@map("app_settings")

}

model IntegrationProvider {
  id               String   @id @default(uuid()) @db.NVarChar(200)
  providerKey      String   @unique @db.NVarChar(200)
  displayName      String @db.NVarChar(Max)
  category         String @db.NVarChar(Max)
  authType         String @db.NVarChar(Max)
  enabled          Boolean  @default(false)
  icon             String? @db.NVarChar(Max)
  documentationUrl String? @db.NVarChar(Max)
  sortOrder        Int      @default(0)
  updatedAt        DateTime @default(now()) @updatedAt
  createdBy        String? @db.NVarChar(Max)
  updatedBy        String? @db.NVarChar(Max)
  createdAt        DateTime @default(now())

  @@map("integration_providers")

}

model HelpArticle {
  id        String   @id @default(uuid()) @db.NVarChar(200)
  slug      String   @unique @db.NVarChar(200)
  section   String @db.NVarChar(Max)
  title     String @db.NVarChar(Max)
  body      String @db.NVarChar(Max)
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)
  updatedAt DateTime @default(now()) @updatedAt
  createdBy String? @db.NVarChar(Max)
  updatedBy String? @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@map("help_articles")

}

model PlanTemplate {
  id            String   @id @default(uuid()) @db.NVarChar(200)
  planType      String @db.NVarChar(Max)
  name          String @db.NVarChar(Max)
  description   String? @db.NVarChar(Max)
  durationWeeks Int?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  createdBy     String? @db.NVarChar(Max)
  updatedBy     String? @db.NVarChar(Max)

  @@map("plan_templates")

}

model Referral {
  id           String   @id @default(uuid()) @db.NVarChar(200)
  referrerId   String @db.NVarChar(200)
  referredId   String @db.NVarChar(200)
  status       String   @default("pending") @db.NVarChar(Max)
  creditAmount Int      @default(10)
  createdAt    DateTime @default(now())
  createdBy    String? @db.NVarChar(Max)
  updatedBy    String? @db.NVarChar(Max)
  updatedAt    DateTime @default(now()) @updatedAt

}

model Task {
  id          String   @id @default(uuid()) @db.NVarChar(200)
  userId      String @db.NVarChar(200)
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String? @db.NVarChar(Max)
  status      String? @db.NVarChar(200)
  due_date    String? @db.NVarChar(200)
  priority    String? @db.NVarChar(Max)
  project     String? @db.NVarChar(Max)
  section     String? @db.NVarChar(Max)
  tags        String? @db.NVarChar(Max)
  done        Boolean  @default(false)
  completedAt String? @db.NVarChar(Max)
  description String? @db.NVarChar(Max)
  category String? @db.NVarChar(Max)
  reminderAt String? @db.NVarChar(Max)
  recurrence String? @db.NVarChar(Max)
  parent_task_id String? @db.NVarChar(Max)
  subtaskRows TaskSubtask[]
  data        String? @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  createdBy   String? @db.NVarChar(Max)
  updatedBy   String? @db.NVarChar(Max)
  updatedAt   DateTime @default(now()) @updatedAt
  @@index([userId, createdAt])
  @@index([userId, status, due_date])

}

model Transaction {
  id        String   @id @default(uuid()) @db.NVarChar(200)
  userId    String @db.NVarChar(200)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount    Float?
  amountMinor BigInt? @ignore
  type      String? @db.NVarChar(Max)
  category  String? @db.NVarChar(Max)
  method    String? @db.NVarChar(Max)
