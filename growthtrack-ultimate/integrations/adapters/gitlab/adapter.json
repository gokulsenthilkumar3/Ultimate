{
  "version": 1,
  "id": "gitlab",
  "category": "CI and version control",
  "kind": "pipeline-template",
  "runtimeEnabled": false,
  "owner": "Workspace CI",
  "contract": {
    "health": "GET /health -> {\"status\":\"ok\"}",
    "authorization": "Domain-owned identity and authorization required before data endpoints",
    "configuration": "Server environment only; no browser-supplied destinations"
  },
  "acceptance": [
    "Independent build and dependency lock",
    "Authenticated contract tests",
    "Timeout/cancellation/error tests",
    "Owner isolation",
    "Backup/rollback or deployment rollback",
    "Explicit owner activation"
  ]
}
