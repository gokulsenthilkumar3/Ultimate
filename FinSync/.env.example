# FinSync Super - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git!

# ========================================
# Firebase Configuration
# ========================================
# Get these from Firebase Console → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=finsync-super.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=finsync-super
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=finsync-super.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://finsync-super-default-rtdb.asia-south1.firebasedatabase.app

# Firebase Admin SDK (Backend only - DO NOT expose to client)
FIREBASE_ADMIN_PROJECT_ID=finsync-super
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@finsync-super.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ========================================
# OpenAI API (AI Transaction Parsing)
# ========================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxx

# ========================================
# Twilio (SMS Parsing)
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# Google APIs
# ========================================
# Gmail API
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Google Maps API (Location tagging)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_maps_api_key

# ========================================
# Microsoft Graph API (Outlook)
# ========================================
MICROSOFT_CLIENT_ID=your_azure_app_client_id
MICROSOFT_CLIENT_SECRET=your_azure_app_secret
MICROSOFT_TENANT_ID=common

# ========================================
# Banking APIs
# ========================================
# Plaid (Global bank sync)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox  # or development, production

# Finvu (India Account Aggregator)
FINVU_API_KEY=your_finvu_api_key
FINVU_ENV=sandbox  # or production

# ========================================
# Investment APIs
# ========================================
# Zerodha Kite Connect
ZERODHA_API_KEY=your_zerodha_api_key
ZERODHA_API_SECRET=your_zerodha_secret

# CoinGecko (Crypto prices)
COINGECKO_API_KEY=your_coingecko_api_key  # Optional for free tier

# Alpha Vantage (Stock market data)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# ========================================
# Payment Gateway
# ========================================
# Razorpay (UPI/Payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ========================================
# Monitoring & Error Tracking
# ========================================
# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Datadog (Optional - for production)
DATADOG_API_KEY=your_datadog_api_key

# ========================================
# Database (Supabase - PostgreSQL)
# ========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_key

# ========================================
# Application Settings
# ========================================
NODE_ENV=development  # or production, test
PORT=3001  # Backend API server port

# Next.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Expo (Mobile)
EXPO_PUBLIC_API_URL=http://localhost:3001/api
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here

# ========================================
# Security
# ========================================
# JWT Secret (for API authentication)
JWT_SECRET=your_super_secret_jwt_key_min_64_chars
JWT_EXPIRES_IN=7d

# Encryption key for sensitive data (PAN, DOB)
ENCRYPTION_KEY=your_32_character_encryption_key

# ========================================
# Third-Party Services
# ========================================
# Customer Support (Intercom/Zendesk)
INTERCOM_APP_ID=your_intercom_app_id

# Email Service (SendGrid/AWS SES)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=noreply@finsyncsuper.com

# ========================================
# Feature Flags
# ========================================
ENABLE_BETA_FEATURES=false
ENABLE_AI_BUDGETING=true
ENABLE_CRYPTO_TRACKING=true

# ========================================
# Development Only
# ========================================
# Skip email verification in dev
SKIP_EMAIL_VERIFICATION=true

# Mock API responses
USE_MOCK_DATA=false

# Enable verbose logging
DEBUG=true
LOG_LEVEL=debug  # error, warn, info, debug

# ========================================
# CI/CD
# ========================================
GITHUB_TOKEN=your_github_token
VERCEL_TOKEN=your_vercel_token
