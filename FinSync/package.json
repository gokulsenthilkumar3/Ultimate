{
  "name": "finsync-super",
  "version": "1.0.0",
  "description": "Unified financial super app - Your CFO in Your Pocket",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:full": "concurrently \"npm run firebase:emulators\" \"npm run dev\"",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "web:dev": "npm run dev --workspace=apps/web",
    "mobile:dev": "npm run dev --workspace=apps/mobile",
    "backend:dev": "npm run dev --workspace=apps/backend",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:import": "firebase emulators:start --import=./emulator-data --export-on-exit",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "firebase:verify": "node scripts/verify-firebase-setup.js",
    "firebase:seed": "node scripts/seed-emulator-data.js",
    "type-check": "turbo run type-check",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "firebase-tools": "^15.8.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.0",
    "turbo": "^1.12.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "finance",
    "budget",
    "expense-tracker",
    "investment",
    "fintech",
    "ai",
    "firebase",
    "nextjs",
    "react-native"
  ],
  "author": "FinSync Super Team",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/finsync-super.git"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
