{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "reviewedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "artifacts": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^artifact-\\d{3}$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "status": {
            "type": "string",
            "enum": [
              "unavailable",
              "retained"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "sourceRole": {
            "type": "string",
            "enum": [
              "writer",
              "related"
            ]
          }
        },
        "required": [
          "id",
          "path",
          "status",
          "source",
          "sourceRole"
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "originalTarget": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "artifact": {
            "type": "string",
            "pattern": "^artifact-\\d{3}$"
          }
        },
        "required": [
          "document",
          "originalTarget",
          "artifact"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "reviewedAt",
    "artifacts",
    "references"
  ],
  "additionalProperties": false
}
