# Git
.git/
.gitignore

# Apply the same packaging boundary to this historical build context.
**/.env*
**/*.db
**/*.pem
**/*.key
**/.aws
**/.ssh

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Outputs & large artifacts
outputs/
*.pkl
*.keras
*.h5

# Scratch
scratch/

# Logs
*.log

# Notebooks
*.ipynb
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# MLflow local runs
mlruns/

# CI
.github/

# Docs
*.docx
*.pdf
*.pptx

# Machine-local code retrieval files are not runtime dependencies.
**/.code-index
**/.code-index/**
**/.codeindexignore

# Private credentials and database sidecars are never build inputs.
**/*.db-*
**/*.db.enc*
**/*.sqlite*
**/*.p12
**/*.pfx
**/.secrets
**/secrets
**/credentials*.json
**/service-account*.json
**/serviceAccountKey*.json
**/firebase-adminsdk*.json
**/.streamlit/secrets.toml
